    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run finetuning",
            "type": "python",
            "request": "launch",
            "program": "audiocap/train_whisper_supervised.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "NCCL_P2P_DISABLE": "0",
                "NCCL_IB_DISABLE": "0",
            },
            "args": [
                "--checkpoint-dir-root", "./checkpoints", 
                "--dataset-name", "cahya/audiosnippets-tiny", 
                "--dataset-type", "mitermix", 
                "--train-split", "0.9",
                "--max-rows", "1000",
                "--training-config", "./configs/finetune_tiny_config_laion.yaml",
                "--load-checkpoint", "../models/whisper-tiny-audio-captioning-v1.5",
                "--wandb-group", "debug-finetuning",
            ]
        },
        {
            "name": "Run finetuning small",
            "type": "python",
            "request": "launch",
            "program": "audiocap/train_whisper_supervised.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0,1",
                "NCCL_P2P_DISABLE": "0",
                "NCCL_IB_DISABLE": "0",
            },
            "args": [
                "--checkpoint-dir-root", "./checkpoints", 
                "--dataset-name", "cahya/audiosnippets-tiny", 
                "--dataset-type", "mitermix", 
                "--train-split", "0.9",
                "--max-rows", "1000",
                "--training-config", "./configs/finetune_small_config_laion.yaml",
                "--load-checkpoint", "../models/whisper-small",
                "--wandb-group", "debug-finetuning",
            ]
        },
        {
            "name": "Run finetuning emo",
            "type": "python",
            "request": "launch",
            "program": "audiocap/train_whisper_supervised.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "NCCL_P2P_DISABLE": "0",
                "NCCL_IB_DISABLE": "0",
            },
            "args": [
                "--checkpoint-dir-root", "./checkpoints", 
                "--dataset-name", "mitermix/audiosnippets_long_50k", 
                "--dataset-type", "mitermix", 
                "--train-split", "0.99",
                "--max-rows", "0",
                "--training-config", "./configs/finetune_base_config_laion_emo.yaml",
                "--load-checkpoint", "../models/whisper-base-audio-captioning-v1.0",
                "--wandb-group", "debug-finetuning",
            ]
        },
        {
            "name": "Run dataset store",
            "type": "python",
            "request": "launch",
            "program": "audiocap/dataset_store.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--dataset-name", "cahya/audiosnippets-tiny", 
                "--train-split", "0.5",
                "--max-rows", "250",
                "--dataset-column-audio", "mp3",
                "--dataset-column-metadata", "json",
                "--dataset-column-file-name", "sample_id",
                "--dataset-column-duration", "duration",
                "--dataset-column-duration-scale", "1.0",
                // "--dataset-with-emotion",
                "--dataset-with-caption",
                // "--dataset-with-detailed-caption", "false",
                // "--dataset-with-transcription", "false",
            ]
        },
        {
            "name": "Run mix-all",
            "type": "python",
            "request": "launch",
            "program": "audiocap/train_whisper_supervised.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "8",
            },
            "args": [
                "--checkpoint-dir-root", "./checkpoints", 
                "--clotho-dir", "./data/clotho_v2.1/audiofolder",
                "--audioset-dir", "./data/audioset_small/audiofolder",
                "--audiocaps-dir", "./data/audiocaps/audiofolder",
                "--training-config", "./configs/DEBUG_tiny_config.yaml", 
                "--wandb-group", "debug-mix-all",
            ]
        },
        {
            "name": "Run pretraining",
            "type": "python",
            "request": "launch",
            "program": "audiocap/train_whisper_supervised.py",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "7",
            },
            "args": [
                "--checkpoint-dir-root", "./checkpoints", 
                "--audioset-dir", "./data/audioset_small/audiofolder",
                "--audiocaps-dir", "./data/audiocaps/audiofolder",
                "--training-config", "./configs/pretrain_3on1_small_config.yaml",
                "--wandb-group", "debug-pretraining",
            ]
        },
        {
            "name": "Run emo script",
            "type": "python",
            "request": "launch",
            "program": "scripts/emo_convert.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "NCCL_P2P_DISABLE": "0",
                "NCCL_IB_DISABLE": "0",
            },
            "args": [
                "--dataset-name", "mitermix/audiosnippets_small_with_detailed_annotation2", 
                "--target-dir", "/home/evobits/storageserver_mountpoint/caption/audiosnippets_small",
                "--train-split", "0.995"
            ]
        },
    ]
}